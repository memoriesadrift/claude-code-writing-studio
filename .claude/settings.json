{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(bash .claude/scripts/status.sh)",
      "Bash(bash .claude/scripts/status.sh *)",
      "Bash(bash .claude/scripts/flow-check.sh)",
      "Bash(bash .claude/scripts/flow-check.sh *)",
      "Bash(bash .claude/scripts/continuity-scan.sh)",
      "Bash(bash .claude/scripts/continuity-scan.sh *)",
      "Bash(bash .claude/scripts/cite-scan.sh)",
      "Bash(bash .claude/scripts/cite-scan.sh *)",
      "Bash(bash .claude/scripts/install-tool.sh check *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(git push --force*)",
      "PowerShell(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/prose-guard.sh\"" }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/read-guard.sh\"" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-guard.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/provenance-log.sh\"" }
        ]
      }
    ]
  }
}
