{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(git push --force*)",
      "PowerShell(git reset --hard*)"
    ]
  }
}
